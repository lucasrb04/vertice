# Referência do /opt/vertice/.env de produção. NÃO edite o arquivo da VM à mão: o job `deploy` da
# pipeline monta este conteúdo a partir do Environment `production` do GitHub e o envia a cada deploy;
# o deploy.sh valida e grava com permissão 600. Valores não podem ter $, aspas, crase nem espaço nas pontas.
# (secret) = Settings → Environments → production → Secrets; (var) = mesma tela, Variables;
# (fixo) = constante escrita no próprio workflow.

# --- Aplicação (src/env.ts) ---
NODE_ENV=production
# (fixo) Montada pelo workflow: postgresql://vertice:<POSTGRES_PASSWORD>@postgres:5432/vertice
DATABASE_URL=
DEFAULT_INSTITUTION_SLUG=unifei-itajuba
# (secret) openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://verticehub.online
NEXT_PUBLIC_APP_URL=https://verticehub.online
# (secret) Google Cloud Console → Google Auth Platform → Clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# (var) E-mail @unifei.edu.br do primeiro SYSTEM_ADMIN
INITIAL_ADMIN_EMAIL=
ENABLE_TEST_AUTH=false
# (var) Cloudflare → Turnstile → widget Vértice → Site Key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# (secret) Cloudflare → Turnstile → widget Vértice → Secret Key
TURNSTILE_SECRET_KEY=
# (secret) openssl rand -hex 32
VISITOR_HASH_SECRET=
# (secret) Resend → API Keys (Sending access, domínio verticehub.online)
RESEND_API_KEY=
# (var) Remetente em domínio verificado no Resend
EMAIL_FROM=Vértice <nao-responda@verticehub.online>

# --- Compose de produção ---
APP_DOMAIN=verticehub.online
POSTGRES_USER=vertice
# (secret) openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=vertice
