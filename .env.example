# Copie para .env e preencha (drizzle.config.ts e db:seed leem .env).
NODE_ENV=development
DATABASE_URL=postgresql://vertice:vertice@localhost:5434/vertice_db
# Os testes (Vitest e Playwright) usam .env.test, não este arquivo.
DEFAULT_INSTITUTION_SLUG=unifei-itajuba
# Mínimo de 32 caracteres (ex.: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E-mail do primeiro SYSTEM_ADMIN (opcional)
INITIAL_ADMIN_EMAIL=
# Login de teste: NUNCA habilitar em produção
ENABLE_TEST_AUTH=false
# Cloudflare Turnstile (criação de projeto). Vazias em dev/teste usam as chaves de teste da Cloudflare;
# obrigatórias em produção.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Segredo do HMAC de visitantes anônimos (mín. 32 caracteres; ex.: openssl rand -base64 32). Obrigatório em produção.
VISITOR_HASH_SECRET=
# Resend (e-mails de candidatura). Sem chave, nada é enviado (dev/teste). RESEND_API_KEY e EMAIL_FROM são obrigatórios
# em produção; o remetente precisa estar em domínio verificado no Resend, ex.: Vértice UNIFEI <nao-responda@dominio.com.br>
RESEND_API_KEY=
EMAIL_FROM=
