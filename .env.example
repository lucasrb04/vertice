# Copie para .env.local e preencha.
NODE_ENV=development
DATABASE_URL=postgresql://vertice:vertice@localhost:5432/vertice
# Banco usado pelos testes de integração
DATABASE_URL_TEST=postgresql://vertice:vertice@localhost:5433/vertice_test
DEFAULT_INSTITUTION_SLUG=unifei-itajuba
# Mínimo de 32 caracteres (ex.: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E-mail do primeiro SYSTEM_ADMIN (opcional)
INITIAL_ADMIN_EMAIL=
# Login de teste: NUNCA habilitar em produção
ENABLE_TEST_AUTH=false
